# Скопируйте в .env и задайте секреты. Файл .env не коммитится.
# Пароль PostgreSQL (используется и сервисом postgres, и приложением)
POSTGRES_PASSWORD=change-me-long-random
# Секрет SearXNG (любая длинная случайная строка: openssl rand -hex 32)
SEARXNG_SECRET=change-me-openssl-rand-hex-32

# Модель: на CPU — qwen3:4b, на GPU — qwen3:8b
IPDL_LLM__MODEL=qwen3:4b
# Локальная разработка по http://localhost — cookie без флага Secure
# IPDL_AUTH__COOKIE_SECURE=false
# Порт веб-интерфейса на хосте (только loopback; наружу — через обратный прокси)
IPDL_WEB_PORT=3000
